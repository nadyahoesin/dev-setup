font-family = JetBrains Mono
font-size = 13
# Weight comes from the real font, not smearing: font-thicken fattens every glyph
# by blurring its edges (the "bleedy" look). The installed variable JetBrains
# Mono (brew cask font-jetbrains-mono) gives a clean Medium instead.
font-thicken = false
font-variation = wght=600
font-variation-bold = wght=800
font-variation-italic = wght=600
font-variation-bold-italic = wght=800
adjust-cell-height = 12%
font-feature = -calt
# never blink, whatever the app's DECSCUSR asks for (Claude Code/Codex request a
# blinking cursor while streaming and it flickers through two tmux layers)
cursor-style-blink = false
# ── Noctis (recovered from cmux) ─────────────────────────────────────
# Shared by Ghostty and cmux: both read ~/.config/ghostty/config, which
# includes this file. Keep them in sync by editing here only.
background = #031417
foreground = #c1d4d7
cursor-color = #40d4e7
palette = 0=#324a4d
palette = 1=#e66533
palette = 2=#49e9a6
palette = 3=#e4b781
palette = 4=#49ace9
palette = 5=#df769b
palette = 6=#49d6e9
palette = 7=#b2cacd
palette = 8=#47686c
palette = 9=#e97749
palette = 10=#60ebb1
palette = 11=#e69533
palette = 12=#60b6eb
palette = 13=#e798b3
palette = 14=#60dbeb
palette = 15=#c1d4d7

window-decoration = true
window-save-state = never
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
bell-features = no-title,attention
# agents' own OSC 9/777 notifications would duplicate Agent Notifier's banners
desktop-notifications = false
macos-non-native-fullscreen = visible-menu

unfocused-split-opacity = 0.85
unfocused-split-fill = #000000
confirm-close-surface = false

keybind = super+enter=toggle_fullscreen
# ⌘+ / ⌘- in half-point steps (the default whole point jumps too far)
keybind = super+equal=increase_font_size:0.5
keybind = super+plus=increase_font_size:0.5
keybind = super+minus=decrease_font_size:0.5

# ── tmux is the tab manager ─────────────────────────────────────────
# Every Ghostty window attaches to the shared tmux session "main"
# (created on demand). Ghostty's own tabs are not used; the ⌘ shortcuts
# below send tmux prefix (C-b = \x02) sequences defined in ~/.tmux.conf.

# tabs
keybind = super+t=text:\x02c
keybind = super+w=text:\x02x
keybind = super+s=text:\x02s
keybind = super+r=text:\x02r
keybind = super+shift+r=text:\x02A
keybind = super+shift+left_bracket=text:\x02p
keybind = super+shift+right_bracket=text:\x02n
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029

# splits
keybind = super+d=text:\x02|
keybind = super+shift+d=text:\x02-
keybind = super+alt+left=text:\x02h
keybind = super+alt+down=text:\x02j
keybind = super+alt+up=text:\x02k
keybind = super+alt+right=text:\x02l

# misc
keybind = shift+enter=text:\x1b[13;2u
keybind = alt+enter=text:\x1b\r
keybind = alt+up=text:\x1b[1;3A
keybind = super+shift+k=text:\x02K
keybind = super+shift+u=text:\x02u
keybind = super+shift+m=text:\x02m
keybind = super+slash=text:\x02?
