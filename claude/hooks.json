{
  "SessionStart":     [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh idle" }] }],
  "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh prompt" }] }],
  "Stop":             [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-notify.sh" }, { "type": "command", "command": "~/.config/tmux/agent-state.sh idle" }] }],
  "Notification":     [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-notify.sh" }, { "type": "command", "command": "~/.config/tmux/agent-state.sh notify" }] }],
  "SubagentStart":    [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh bgstart" }] }],
  "SubagentStop":     [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh bgstop" }] }],
  "PreToolUse":       [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "~/.config/claude/guard-search.sh" }] },
                       { "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh pre" }] }],
  "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "~/.config/tmux/agent-state.sh working" }] }]
}
